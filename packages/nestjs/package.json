{
    "name": "@loopkit/nestjs",
    "version": "1.0.0",
    "description": "Production-ready flashcard engine for NestJS — SM-2 SRS algorithm, Prisma adapter, content pipeline",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": ["dist"],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "tsc --noEmit",
        "clean": "rm -rf dist"
    },
    "peerDependencies": {
        "@nestjs/common": "^10.0.0 || ^11.0.0",
        "@nestjs/core": "^10.0.0 || ^11.0.0",
        "rxjs": "^7.0.0",
        "marked": "^15.0.0",
        "katex": "^0.16.0",
        "highlight.js": "^11.0.0",
        "sanitize-html": "^2.0.0"
    },
    "peerDependenciesMeta": {
        "marked": { "optional": true },
        "katex": { "optional": true },
        "highlight.js": { "optional": true },
        "sanitize-html": { "optional": true }
    },
    "devDependencies": {
        "@nestjs/common": "^11.0.0",
        "@nestjs/core": "^11.0.0",
        "rxjs": "^7.8.0",
        "typescript": "^5.7.0",
        "vitest": "^3.0.0",
        "papaparse": "^5.5.0",
        "@types/papaparse": "^5.3.0",
        "@types/sanitize-html": "^2.13.0",
        "reflect-metadata": "^0.2.0"
    },
    "dependencies": {
        "papaparse": "^5.5.0"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/hfu-digital/loopkit"
    }
}
