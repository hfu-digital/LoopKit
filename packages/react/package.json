{
    "name": "@loopkit/react",
    "version": "1.0.0",
    "description": "React hooks and components for LoopKit flashcard engine — headless-first with pre-styled defaults",
    "type": "module",
    "main": "dist/loopkit-react.cjs",
    "module": "dist/loopkit-react.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/loopkit-react.js",
            "require": "./dist/loopkit-react.cjs"
        },
        "./styles.css": "./dist/styles.css"
    },
    "files": ["dist"],
    "scripts": {
        "build": "vite build && tsc --emitDeclarationOnly",
        "dev": "vite build --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "tsc --noEmit",
        "clean": "rm -rf dist"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "devDependencies": {
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "typescript": "^5.7.0",
        "vite": "^6.1.0",
        "vite-plugin-dts": "^4.5.0",
        "@vitejs/plugin-react": "^4.3.0",
        "vitest": "^3.0.0",
        "@testing-library/react": "^16.0.0",
        "@testing-library/jest-dom": "^6.6.0",
        "jsdom": "^25.0.0"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/hfu-digital/loopkit"
    }
}
